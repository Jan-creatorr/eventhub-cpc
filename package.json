{
  "name": "eventhub-cpc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm:server\" \"npm:vite\"",
    "vite": "vite frontend",
    "build": "tsc -b && vite build frontend",
    "lint": "eslint .",
    "preview": "vite preview frontend",
    "server": "tsx watch backend/server/index.ts",
    "server:start": "tsx backend/server/index.ts",
    "dev:all": "npm run dev",
    "typecheck:server": "tsc -p backend/tsconfig.server.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/assistant.test.ts tests/api.test.ts",
    "test:assistant": "node --import tsx --test tests/assistant.test.ts",
    "test:api": "node --import tsx --test tests/api.test.ts",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "db:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-db.ps1",
    "db:generate": "drizzle-kit generate --config=backend/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=backend/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=backend/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=backend/drizzle.config.ts",
    "db:seed": "tsx backend/server/db/seed.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.70.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
