# Copy this file to .env and fill in your own values.

# ---- EventHub | Cordova Public College ----
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Frontend only. Keep /api to use the Vite dev proxy, or set the full API URL.
VITE_API_URL=/api

# ---- MySQL (temporary source for data migration) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace-with-your-db-user
DB_PASSWORD=replace-with-your-db-password
DB_NAME=eventhub_cpc

# ---- PostgreSQL (Neon) ----
DATABASE_URL=replace-with-your-neon-pooled-connection-string
DIRECT_URL=replace-with-your-neon-direct-connection-string

# ---- JWT secrets (use long random strings in production) ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---- AI Assistant (optional) ----
# Leave AI_API_KEY empty to use the built-in EventHub knowledge base.
# OPENAI_API_KEY is accepted as a fallback. Use a dedicated, restricted key,
# keep it only in .env, and never commit or document a real value.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=600
